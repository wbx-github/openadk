+#ifdef TARGET_v850
+/* Objects for the RH850 ABI (the default since binutils 2.24) carry
+   the V800 relocation numbers; map them to the V850 ones that the
+   code below knows.  */
+static int v850_reloc_type(const arelent *r)
+{
+	switch (r->howto->type) {
+	case R_V810_WORD:
+	case R_V810_ABS32:
+		return R_V850_ABS32;
+	case R_V810_WHI1:
+		return R_V850_HI16_S;
+	case R_V810_WHI:
+		return R_V850_HI16;
+	case R_V810_WLO:
+		return R_V850_LO16;
+	case R_V810_WLO_1:
+		/* lower half of a ld.w/st.w displacement, bit 0 is the
+		   opcode; elf2flt calls this a ZDA_15_16_OFFSET  */
+		return R_V850_ZDA_15_16_OFFSET;
+	case R_V850_PC9:
+		return R_V850_9_PCREL;
+	case R_V850_PCR22:
+	case R_V850_PC16U:
+	case R_V850_PC17:
+	case R_V850_PC32:
+		return R_V850_22_PCREL;
+	default:
+		return r->howto->type;
+	}
+}
+#define RELOC_TYPE(r)	v850_reloc_type(r)
+#else
+#define RELOC_TYPE(r)	((r)->howto->type)
+#endif
+
