--- a/gcc/config.gcc	2026-08-07 07:46:05.819684556 +0000
+++ b/gcc/config.gcc	2026-10-26 18:39:54.654104928 +0000
@@ -3637,6 +3637,22 @@
 	c_target_objs="v850-c.o"
 	cxx_target_objs="v850-c.o"
 	;;
+v850*-*-linux*)
+	# The kernel (arch/v850, removed in 2.6.27) needs at least V850E.
+	case ${target} in
+	v850e1-*-* | v850es-*-*)
+		target_cpu_default="TARGET_CPU_v850e1"
+		;;
+	*)
+		target_cpu_default="TARGET_CPU_v850e"
+		;;
+	esac
+	tm_file="elfos.h gnu-user.h linux.h glibc-stdint.h v850/v850.h v850/linux.h"
+	tmake_file="${tmake_file} v850/t-v850"
+	use_collect2=no
+	c_target_objs="${c_target_objs} v850-c.o"
+	cxx_target_objs="${cxx_target_objs} v850-c.o"
+	;;
 v850*-*-*)
 	case ${target} in
 	v850e3v5-*-*)
