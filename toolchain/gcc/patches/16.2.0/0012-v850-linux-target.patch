+#ifndef GCC_V850_LINUX_H
+#define GCC_V850_LINUX_H
+
+#undef TARGET_OS_CPP_BUILTINS
+#define TARGET_OS_CPP_BUILTINS()		\
+  do						\
+    {						\
+      GNU_USER_TARGET_OS_CPP_BUILTINS ();	\
+      builtin_define ("__uClinux__");		\
+    }						\
+  while (0)
+
+/* v850.h drops the specs from gnu-user.h; give them back.  Programs
+   are linked statically and turned into FLAT binaries.  */
+#undef STARTFILE_SPEC
+#define STARTFILE_SPEC "crt1.o%s crti.o%s crtbegin.o%s"
+
+#undef ENDFILE_SPEC
+#define ENDFILE_SPEC "crtend.o%s crtn.o%s"
+
+#undef LIB_SPEC
+#define LIB_SPEC "%{pthread:-lpthread} -lc"
+
+#endif /* GCC_V850_LINUX_H */
