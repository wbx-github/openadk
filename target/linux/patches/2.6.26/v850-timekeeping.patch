v850: Disable clocksource adjustment for jiffies clocksource

Avoids a hanging system after approx. 10 seconds.

diff -Nur linux-2.6.26.orig/kernel/time/timekeeping.c linux-2.6.26/kernel/time/timekeeping.c
--- linux-2.6.26.orig/kernel/time/timekeeping.c	2008-07-13 23:51:29.000000000 +0200
+++ linux-2.6.26/kernel/time/timekeeping.c	2026-11-03 00:08:27.714100060 +0100
@@ -19,6 +19,7 @@
 #include <linux/time.h>
 #include <linux/tick.h>
 
+extern struct clocksource clocksource_jiffies;
 
 /*
  * This read-write spinlock protects us from races in SMP while
@@ -411,6 +412,13 @@
 	s64 error, interval = clock->cycle_interval;
 	int adj;
 
+	 /*
+         * The jiffies clocksource is driven by the kernel timer tick.
+         * Keep its conversion factor fixed.
+         */
+        if (clock == &clocksource_jiffies)
+                return;
+
 	error = clock->error >> (NTP_SCALE_SHIFT - clock->shift - 1);
 	if (error > interval) {
 		error >>= 2;
