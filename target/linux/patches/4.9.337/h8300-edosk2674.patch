diff -Nur linux-4.4.302.orig/drivers/irqchip/irq-renesas-h8s.c linux-4.4.302/drivers/irqchip/irq-renesas-h8s.c
--- linux-4.9.337.orig/drivers/irqchip/irq-renesas-h8s.c
+++ linux-4.9.337/drivers/irqchip/irq-renesas-h8s.c
@@ -6,13 +6,42 @@
 
 #include <linux/irq.h>
 #include <linux/irqchip.h>
+#include <linux/timer.h>
+#include <linux/jiffies.h>
+#include <linux/init.h>
+#include <linux/sched.h>
+#include <linux/string.h>
+#include <linux/workqueue.h>
+#include <linux/delay.h>
+#include <linux/irqflags.h>
+#include <linux/netdevice.h>
+#include <net/net_namespace.h>
+#include <linux/smp.h>
 #include <linux/of_address.h>
 #include <linux/of_irq.h>
 #include <asm/io.h>
 
+/*
+ * 4.9 dropped ctrl_inw/ctrl_outw from asm/io.h.  Use raw (native
+ * big-endian) accesses: the generic readw/writew byte-swap on H8/300.
+ */
+#define ctrl_inw(a)	__raw_readw((void __iomem *)(unsigned long)(a))
+#define ctrl_outw(v, a)	__raw_writew((v), (void __iomem *)(unsigned long)(a))
+
 static void *intc_baseaddr;
+static unsigned long h8s_ack_cnt;	/* external IRQ acks, for debugging */
 #define IPRA ((unsigned long)intc_baseaddr)
 
+/* External IRQ0-IRQ15 are hardware irq 16-31 */
+#define EXT_IRQ_FIRST	16
+#define EXT_IRQ_LAST	31
+
+/* ISCRH: IRQ15-8, ISCRL: IRQ7-0, 2 bits per pin (verify in the manual) */
+#define H8S_ISCRH	0xFFFE1A
+#define H8S_ISCRL	0xFFFE1C
+#define H8S_IER		0xFFFF32
+#define H8S_ISR		0xFFFF34
+
 static const unsigned char ipr_table[] = {
 	0x03, 0x02, 0x01, 0x00, 0x13, 0x12, 0x11, 0x10, /* 16 - 23 */
 	0x23, 0x22, 0x21, 0x20, 0x33, 0x32, 0x31, 0x30, /* 24 - 31 */
@@ -30,45 +59,182 @@
 	0xa0, 0xa0, 0xa0, 0xa0, 0xa0, 0xa0, 0xa0, 0xa0, /* 120 - 127 */
 };
 
-static void h8s_disable_irq(struct irq_data *data)
+/* bit in IER/ISR for an external IRQ pin, 0 for every other interrupt */
+static inline unsigned short h8s_ext_bit(struct irq_data *data)
+{
+	unsigned long hw = irqd_to_hwirq(data);
+
+	if (hw < EXT_IRQ_FIRST || hw > EXT_IRQ_LAST)
+		return 0;
+	return 1 << (hw - EXT_IRQ_FIRST);
+}
+
+static inline void h8s_ier_set(unsigned short bit)
+{
+	ctrl_outw(ctrl_inw(H8S_IER) | bit, H8S_IER);
+}
+
+static inline void h8s_ier_clr(unsigned short bit)
+{
+	ctrl_outw(ctrl_inw(H8S_IER) & ~bit, H8S_IER);
+}
+
+static inline void h8s_isr_clr(unsigned short bit)
+{
+	/*
+	 * A flag is cleared by reading it as 1 and then writing 0 to it.
+	 * Writing 1 to the other bits has no effect, so write ~bit instead
+	 * of a read-modify-write of the whole register.
+	 */
+	if (ctrl_inw(H8S_ISR) & bit)
+		ctrl_outw((unsigned short)~bit, H8S_ISR);
+}
+
+static void h8s_ipr(struct irq_data *data, int on)
 {
 	int pos;
 	unsigned int addr;
 	unsigned short pri;
-	int irq = data->irq;
+	int irq = irqd_to_hwirq(data);
 
 	addr = IPRA + ((ipr_table[irq - 16] & 0xf0) >> 3);
 	pos = (ipr_table[irq - 16] & 0x0f) * 4;
 	pri = ~(0x000f << pos);
-	pri &= readw(addr);
-	writew(pri, addr);
+	pri &= ctrl_inw(addr);
+	if (on)
+		pri |= 1 << pos;
+	ctrl_outw(pri, addr);
+}
+
+static void h8s_disable_irq(struct irq_data *data)
+{
+	unsigned short bit = h8s_ext_bit(data);
+
+	h8s_ipr(data, 0);
+	if (bit)
+		h8s_ier_clr(bit);
 }
 
 static void h8s_enable_irq(struct irq_data *data)
 {
-	int pos;
-	unsigned int addr;
-	unsigned short pri;
-	int irq = data->irq;
+	unsigned short bit = h8s_ext_bit(data);
 
-	addr = IPRA + ((ipr_table[irq - 16] & 0xf0) >> 3);
-	pos = (ipr_table[irq - 16] & 0x0f) * 4;
-	pri = ~(0x000f << pos);
-	pri &= readw(addr);
-	pri |= 1 << pos;
-	writew(pri, addr);
+	if (bit) {
+		pr_info("h8s-intc: enable hwirq %lu: IER=%04x ISR=%04x ISCRH=%04x ISCRL=%04x\n",
+			irqd_to_hwirq(data), ctrl_inw(H8S_IER),
+			ctrl_inw(H8S_ISR), ctrl_inw(H8S_ISCRH),
+			ctrl_inw(H8S_ISCRL));
+		/*
+		 * Do NOT clear ISR here: an edge that arrived while the irq
+		 * was disabled (disable_irq()/enable_irq()) is latched in ISR
+		 * and must be delivered once IER is set again.  The flag is
+		 * cleared in set_type and at init only.
+		 */
+		h8s_ier_set(bit);
+	}
+	h8s_ipr(data, 1);
+}
+
+/* mask/unmask/ack are used by the edge and level flow handlers */
+static void h8s_mask_irq(struct irq_data *data)
+{
+	unsigned short bit = h8s_ext_bit(data);
+
+	if (bit)
+		h8s_ier_clr(bit);
+	else
+		h8s_ipr(data, 0);
+}
+
+static void h8s_unmask_irq(struct irq_data *data)
+{
+	unsigned short bit = h8s_ext_bit(data);
+
+	if (bit)
+		h8s_ier_set(bit);
+	else
+		h8s_ipr(data, 1);
+}
+
+static void h8s_ack_irq(struct irq_data *data)
+{
+	unsigned short bit = h8s_ext_bit(data);
+
+	if (bit) {
+		h8s_ack_cnt++;
+		h8s_isr_clr(bit);
+	}
+}
+
+static int h8s_set_type(struct irq_data *data, unsigned int type)
+{
+	unsigned short bit = h8s_ext_bit(data);
+	unsigned int hw = irqd_to_hwirq(data) - EXT_IRQ_FIRST;
+	unsigned short ier, val, sense;
+	unsigned long reg;
+	irq_flow_handler_t handler;
+
+	if (!bit)
+		return -EINVAL;
+
+	/* pin sense: 00 low level, 01 falling, 10 rising, 11 both edges */
+	switch (type & IRQ_TYPE_SENSE_MASK) {
+	case IRQ_TYPE_LEVEL_LOW:
+		sense = 0;
+		handler = handle_level_irq;
+		break;
+	case IRQ_TYPE_EDGE_FALLING:
+		sense = 1;
+		handler = handle_edge_irq;
+		break;
+	case IRQ_TYPE_EDGE_RISING:
+		sense = 2;
+		handler = handle_edge_irq;
+		break;
+	case IRQ_TYPE_EDGE_BOTH:
+		sense = 3;
+		handler = handle_edge_irq;
+		break;
+	default:
+		/* the pins cannot sense a high level */
+		return -EINVAL;
+	}
+
+	ier = ctrl_inw(H8S_IER);
+	ctrl_outw(ier & ~bit, H8S_IER);
+
+	reg = (hw < 8) ? H8S_ISCRL : H8S_ISCRH;
+	val = ctrl_inw(reg);
+	val &= ~(3 << ((hw & 7) * 2));
+	val |= sense << ((hw & 7) * 2);
+	ctrl_outw(val, reg);
+
+	h8s_isr_clr(bit);
+	ctrl_outw(ier, H8S_IER);
+
+	irq_set_handler_locked(data, handler);
+	pr_info("h8s-intc: hwirq %lu set_type %u (sense %u)\n",
+		irqd_to_hwirq(data), type & IRQ_TYPE_SENSE_MASK, sense);
+	return 0;
 }
 
