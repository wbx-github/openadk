diff -Nur linux-4.4.302.orig/arch/h8300/kernel/entry.S linux-4.4.302/arch/h8300/kernel/entry.S
--- linux-4.4.302.orig/arch/h8300/kernel/entry.S	2022-02-03 09:27:54.000000000 +0100
+++ linux-4.4.302/arch/h8300/kernel/entry.S	2026-11-18 20:52:45.500391670 +0100
@@ -77,6 +77,23 @@
 	.endm
 #endif
 
+/*
+ * H8S: the interrupt mask is CCR.I in interrupt control mode 0 but the EXR
+ * mask level in mode 2.  Mask/unmask both so the kernel works in either.
+ */
+#if defined(CONFIG_CPU_H8S)
+	.macro	IRQ_OFF_EXR
+	orc	#7,exr
+	.endm
+	.macro	IRQ_ON_EXR
+	andc	#0xf8,exr
+	.endm
+#else
+	.macro	IRQ_OFF_EXR
+	.endm
+	.macro	IRQ_ON_EXR
+	.endm
+#endif
 
 /* CPU context save/restore macros. */
 
@@ -131,6 +148,7 @@
 	bne	7f
 
 	orc	#0xc0,ccr
+	IRQ_OFF_EXR
 	mov.l	@(LSP-LER1:16,sp),er0
 	mov.l	@(LER0-LER1:16,sp),er1		/* restore ER0 */
 	mov.l	er1,@er0
@@ -233,10 +251,13 @@
 	jmp	@ret_from_interrupt
 
 _system_call:
+	IRQ_OFF_EXR				/* TRAPA does not mask in mode 2 */
 	subs	#4,sp				/* dummy LVEC */
 	SAVE_ALL
 	/* er0: syscall nr */
-	andc	#0xbf,ccr
+	/* TRAPA sets I in CCR; run the syscall with interrupts enabled */
+	andc	#0x3f,ccr
+	IRQ_ON_EXR
 	mov.l	er0,er4
 
 	/* save top of frame */
@@ -271,6 +292,7 @@
 	jsr	@do_syscall_trace_leave
 2:
 	orc	#0xc0,ccr
+	IRQ_OFF_EXR
 	bra	resume_userspace
 
 badsys:
@@ -358,6 +380,7 @@
 
 	/* disable interrupts */
 	orc	#0xc0,ccr
+	IRQ_OFF_EXR
 	mov.l	@_sw_usp,er3
 	mov.l	er3,@(THREAD_USP:16,er0)
 	mov.l	sp,@(THREAD_KSP:16,er0)
