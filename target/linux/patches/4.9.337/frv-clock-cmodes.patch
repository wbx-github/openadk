# frv: clock_cmodes is a writable pointer to constant tables.
# It was declared __pminitconst, so the pointer itself landed in a
# read-only init section next to __pminitdata objects: gcc 15 rejects
# the section type conflict.
--- a/arch/frv/kernel/setup.c
+++ b/arch/frv/kernel/setup.c
@@ -185,7 +185,7 @@ static struct clock_cmode __pminitdata clock_cmodes_fr555[16] = {
 	[6]	= {	_x1,	_x1_5,	_x1_5,	_x4_5,	_x0_375	},
 };
 
-static const struct clock_cmode __pminitconst *clock_cmodes;
+static const struct clock_cmode *__pminitdata clock_cmodes;
 static int __pminitdata clock_doubled;
 
 static struct uart_port __pminitdata __frv_uart0 = {
