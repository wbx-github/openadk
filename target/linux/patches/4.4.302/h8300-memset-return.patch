# h8300: memset must return its first argument.
# memset.S left er0 at the end of the buffer.  gcc relies on memset returning
# the pointer it was given: rtnetlink_rcv_msg zeroes its netlink_dump_control
# with memset and passes the return value on as the pointer, so
# __netlink_dump_start called stack garbage as cb->start and every
# RTM_GETLINK dump (if_nameindex, getifaddrs) crashed the machine.
# Still the same in 5.18.
--- a/arch/h8300/lib/memset.S
+++ b/arch/h8300/lib/memset.S
@@ -17,7 +17,9 @@
 ;; ptr = er0
 ;; c   = er1(r1l)
 ;; count = er2
+;; returns ptr, as C wants and gcc assumes
 memset:
+	mov.l	er0,@-sp
 	btst	#0,r0l
 	beq	2f
 
@@ -59,6 +61,7 @@
 	dec.b	r3l
 	bne	5b
 6:
+	mov.l	@sp+,er0
 	rts
 
 clear_user:
