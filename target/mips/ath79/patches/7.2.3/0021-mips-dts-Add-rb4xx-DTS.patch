 .../ar7100_mikrotik_routerboard-4xx.dtsi      | 167 ++++++++++++
 .../ar7161_mikrotik_routerboard-493g.dts      |  53 ++++
 arch/mips/boot/dts/mikrotik/ath79.dtsi        |  95 +++++++
 6 files changed, 559 insertions(+)
