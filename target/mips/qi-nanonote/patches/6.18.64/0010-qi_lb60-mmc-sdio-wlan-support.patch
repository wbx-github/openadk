+			bias-pull-up;
 		};
 
 		mmc-gpios {
@@ -369,6 +369,13 @@
 			bias-disable;
 		};
 	};
+
+	/* MMC bus driven low while the slot is powered off */
+	pins_mmc_sleep: mmc-sleep {
+		pins = "PD8", "PD9", "PD10", "PD11", "PD12", "PD13";
+		bias-disable;
+		output-low;
+	};
 };
 
 &mmc {
@@ -377,8 +384,12 @@
 	cd-gpios = <&gpd 0 GPIO_ACTIVE_HIGH>;
 	vmmc-supply = <&mmc_power>;
 
