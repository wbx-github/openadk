+	/* SDIO WLAN cards (Spectec SDW-823, KS7010) need time after power-up */
+	post-power-on-delay-ms = <200>;
+
+	pinctrl-names = "default", "sleep";
 	pinctrl-0 = <&pins_mmc>;
+	pinctrl-1 = <&pins_mmc_sleep>;
 };
 
