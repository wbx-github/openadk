--- a/arch/mips/boot/dts/ingenic/qi_lb60.dts
+++ b/arch/mips/boot/dts/ingenic/qi_lb60.dts
@@ -361,7 +361,7 @@
 		mmc {
 			function = "mmc";
 			groups = "mmc-1bit", "mmc-4bit";
